upstream diagram_api {
    zone diagram_api 64k;
    # Docker DNS tracks the API when its container is recreated.
    resolver 127.0.0.11 valid=5s ipv6=off;
    server ${API_HOST}:${API_PORT} resolve;
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass http://diagram_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Status events are delivered as Server-Sent Events.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
