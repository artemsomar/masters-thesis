APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_REDIS_URL=redis://redis:6379/0
APP_RQ_QUEUE_NAME=diagram-jobs
APP_SESSION_TTL_SECONDS=86400
APP_SESSION_TOKEN_PEPPER=replace-with-a-long-random-secret
GEMINI_API_KEY=replace-with-a-gemini-api-key
APP_GEMINI_MODEL=replace-with-a-gemini-model
APP_MAX_CLARIFICATION_ROUNDS=3
APP_MAX_QUESTIONS_PER_ROUND=7
APP_MAX_DESCRIPTION_LENGTH=20000
APP_MAX_ANSWER_LENGTH=2000
APP_SESSION_CREATION_LIMIT_PER_DAY=100
APP_MAX_ACTIVE_SESSIONS_PER_CLIENT=10
APP_LLM_JOB_TIMEOUT_SECONDS=120
APP_LLM_JOB_MAX_ATTEMPTS=3
APP_LLM_JOB_RETRY_INTERVALS_SECONDS=[10,20]
